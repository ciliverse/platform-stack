# Copy to values/private.yaml (gitignored).
#
#   cp values/private.yaml.example values/private.yaml
#   openssl rand -hex 16   # jwtSecret (>=16) and encryptionKey (exactly 32)
#   openssl rand -hex 16   # redis.password (hex avoids metaurl encoding)
#
# Default env (MetalLB on): metallb.addresses MUST be a real L2 range on the
# LAN, not the placeholder below, or helmfile template/apply fails.

# Required as long as apps.cilikube is on (it is, by default): the app refuses
# the chart's placeholder values at startup, so helmfile fails until these are
# real. Both are rejected while they still start with REPLACE_ME.
secrets:
  jwtSecret: "REPLACE_ME_GENERATE_WITH_openssl_rand"
  encryptionKey: "REPLACE_ME_32_CHARS_openssl_hex16"

metallb:
  addresses: "192.168.0.0-192.168.0.0"

# Class for the example Ingresses and the ACME http01 solver. APISIX serves
# Ingress; Envoy Gateway does not (Gateway API only), so if APISIX is off this
# has to name a controller that is actually running.
ingressClass: apisix

letsencrypt:
  email: ""

# Turn this on instead of letsencrypt when the hosts resolve to addresses ACME
# cannot reach (LAN, split-horizon DNS). It signs a root the cluster owns and
# adds a `local-ca` ClusterIssuer; import the root into clients once:
#   kubectl get secret local-ca-tls -n cert-manager \
#     -o jsonpath='{.data.ca\.crt}' | base64 -d > local-ca.crt
localCa:
  enabled: false

fluxGitops:
  gitUrl: ""
  branch: main
  # read-only token for Flux to clone the repo (not the CI write token);
  # leave empty for a public repo
  deployToken: ""
  # one entry per directory Flux should apply; without any, the repo is
  # fetched but nothing lands in the cluster
  kustomizations: []
  # - name: demo
  #   path: ./apps/demo
  #   namespace: demo        # where the Kustomization object lives; default flux-system
  #   createNamespace: true

hosts:
  cilikube: ""
  grafana: ""
  # Set these to render an Ingress for the release; empty means no Ingress.
  argocd: ""
  jenkins: ""

redis:
  password: ""

rustfs:
  accessKey: ""
  secretKey: ""

minio:
  rootUser: ""
  rootPassword: ""

juicefs:
  name: "jfs"

harbor:
  adminPassword: ""

gitlabRunner:
  gitlabUrl: ""
  runnerToken: ""

# Only when apps.gitlab is on. Chart 10.x bundles no database, cache or object
# storage: psqlHost / redisHost default to this repo's own postgresql / redis
# releases when those are enabled, otherwise point them at something external.
# The Secrets named below are NOT created by this repo — create them in the
# GitLab namespace first (README: GitLab). Defaults shown; omit to accept them.
gitlab:
  domain: ""                     # required; every GitLab URL is built from it
  psqlHost: ""                   # empty + apps.postgresql on -> postgresql.<ns>.svc
  psqlUsername: gitlab
  psqlDatabase: gitlabhq_production
  psqlPasswordSecret: gitlab-psql            # key: password
  redisHost: ""                  # empty + apps.redis on -> redis-master.<ns>.svc
  redisPasswordSecret: gitlab-redis          # key: redis-password
  objectStorageSecret: gitlab-object-storage # key: connection
  registryStorageSecret: gitlab-registry-storage  # key: config
  backupConfigSecret: gitlab-s3cmd           # key: config
  registryBucket: gitlab-registry
  backupBucket: gitlab-backups
  backupTmpBucket: gitlab-backups-tmp

externalDns:
  provider: ""
  txtOwnerId: "helm-charts"
  domainFilters: []
  cloudflareApiToken: ""
