# missingFileHandler belongs next to `values:`, not inside the list. A map in
# the list is inline values, so `- path: values/private.yaml` would read as two
# state values named path and missingFileHandler and the file would never load.
environments:
  default:
    missingFileHandler: Warn
    values:
      - values/defaults.yaml
      - values/private.yaml
  kind:
    missingFileHandler: Warn
    values:
      - values/defaults.yaml
      - values/kind.yaml
      - values/private.yaml
---
{{- if .Values.apps.victoriaLogsCollector.enabled }}
{{- if not .Values.apps.victoriaLogs.enabled }}
{{- fail "victoriaLogsCollector requires apps.victoriaLogs.enabled" }}
{{- end }}
{{- end }}
{{- if and .Values.apps.victoriaLogs.enabled .Values.apps.loki.enabled }}
{{- fail "victoriaLogs and loki are mutually exclusive; enable only one log store" }}
{{- end }}
{{- if .Values.apps.juicefsCsi.enabled }}
{{- if not .Values.apps.redis.enabled }}
{{- fail "juicefs requires apps.redis.enabled" }}
{{- end }}
{{- if and (not .Values.apps.rustfs.enabled) (not .Values.apps.minio.enabled) }}
{{- fail "juicefs requires rustfs or minio" }}
{{- end }}
{{- $rp := dig "redis" "password" "" .Values }}
{{- if not $rp }}
{{- fail "juicefs requires redis.password in values/private.yaml" }}
{{- end }}
{{- end }}
{{- if .Values.apps.redis.enabled }}
{{- $rp := dig "redis" "password" "" .Values }}
{{- if not $rp }}
{{- fail "set redis.password in values/private.yaml" }}
{{- end }}
{{- end }}
{{/*
GitLab 10.x renders only with an external database, cache and object store.
Default to this repo's own postgresql / redis releases when they are on, so the
common case needs one line (gitlab.domain) in private.yaml.
*/}}
{{- $glPsql := dig "gitlab" "psqlHost" "" .Values }}
{{- if and (not $glPsql) .Values.apps.postgresql.enabled }}
{{- $glPsql = printf "postgresql.%s.svc" .Values.apps.postgresql.namespace }}
{{- end }}
{{- $glRedis := dig "gitlab" "redisHost" "" .Values }}
{{- if and (not $glRedis) .Values.apps.redis.enabled }}
{{- $glRedis = printf "redis-master.%s.svc" .Values.apps.redis.namespace }}
{{- end }}
{{- if .Values.apps.gitlab.enabled }}
{{- if not (dig "gitlab" "domain" "" .Values) }}
{{- fail "gitlab.enabled requires gitlab.domain in values/private.yaml (GitLab builds every URL from it)" }}
{{- end }}
{{- if not $glPsql }}
{{- fail "gitlab.enabled requires an external PostgreSQL: enable apps.postgresql or set gitlab.psqlHost in values/private.yaml (chart 10.x bundles none)" }}
{{- end }}
{{- if not $glRedis }}
{{- fail "gitlab.enabled requires an external Redis: enable apps.redis or set gitlab.redisHost in values/private.yaml (chart 10.x bundles none)" }}
{{- end }}
{{- end }}
{{- if .Values.apps.cilikube.enabled }}
{{- $js := dig "secrets" "jwtSecret" "" .Values }}
{{- $ek := dig "secrets" "encryptionKey" "" .Values }}
{{- if or (lt (len $js) 16) (hasPrefix "REPLACE_ME" $js) }}
{{- fail "cilikube requires secrets.jwtSecret in values/private.yaml (>=16 chars; the app refuses the chart default at startup)" }}
{{- end }}
{{- if or (ne (len $ek) 32) (hasPrefix "REPLACE_ME" $ek) }}
{{- fail "cilikube requires secrets.encryptionKey in values/private.yaml (exactly 32 chars; the app refuses the chart default at startup)" }}
{{- end }}
{{- end }}
{{- if .Values.apps.metallb.enabled }}
{{- $addr := dig "metallb" "addresses" "" .Values }}
{{- if or (eq $addr "") (eq $addr "192.168.0.0-192.168.0.0") }}
{{- fail "set metallb.addresses in values/private.yaml to a real L2 range (not 192.168.0.0-192.168.0.0)" }}
{{- end }}
{{- end }}
{{- if .Values.apps.rustfs.enabled }}
{{- $ak := dig "rustfs" "accessKey" "" .Values }}
{{- $sk := dig "rustfs" "secretKey" "" .Values }}
{{- if or (eq $ak "") (eq $sk "") (eq $ak "rustfsadmin") }}
{{- fail "set rustfs.accessKey and rustfs.secretKey in values/private.yaml (not rustfsadmin)" }}
{{- end }}
{{- end }}
{{- if .Values.apps.minio.enabled }}
{{- $mu := dig "minio" "rootUser" "" .Values }}
{{- $mp := dig "minio" "rootPassword" "" .Values }}
{{- if or (eq $mu "") (eq $mp "") }}
{{- fail "set minio.rootUser and minio.rootPassword in values/private.yaml" }}
{{- end }}
{{- end }}
{{- if .Values.apps.harbor.enabled }}
{{- $hp := dig "harbor" "adminPassword" "" .Values }}
{{- if or (eq $hp "") (eq $hp "Harbor12345") }}
{{- fail "set harbor.adminPassword in values/private.yaml (not Harbor12345)" }}
{{- end }}
{{- end }}
{{- if .Values.apps.gitlabRunner.enabled }}
{{- $gu := dig "gitlabRunner" "gitlabUrl" "" .Values }}
{{- $rt := dig "gitlabRunner" "runnerToken" "" .Values }}
{{- if or (eq $gu "") (eq $rt "") }}
{{- fail "set gitlabRunner.gitlabUrl and gitlabRunner.runnerToken in values/private.yaml" }}
{{- end }}
{{- end }}
{{- if .Values.apps.externalDns.enabled }}
{{- $p := dig "externalDns" "provider" "" .Values }}
{{- if eq $p "" }}
{{- fail "set externalDns.provider in values/private.yaml (e.g. cloudflare)" }}
{{- end }}
{{- if and (eq $p "cloudflare") (eq (dig "externalDns" "cloudflareApiToken" "" .Values) "") }}
{{- fail "set externalDns.cloudflareApiToken in values/private.yaml" }}
{{- end }}
{{- end }}
{{- if and (.Values.letsencrypt.enabled | default false) (not (dig "letsencrypt" "email" "" .Values)) }}
{{- fail "letsencrypt.enabled requires letsencrypt.email in values/private.yaml" }}
{{- end }}
{{- if .Values.fluxGitops.enabled }}
{{- if not (dig "fluxGitops" "gitUrl" "" .Values) }}
{{- fail "fluxGitops.enabled requires fluxGitops.gitUrl in values/private.yaml" }}
{{- end }}
{{- if not (dig "fluxGitops" "kustomizations" (list) .Values) }}
{{- fail "fluxGitops.enabled requires fluxGitops.kustomizations in values/private.yaml" }}
{{- end }}
{{- if not .Values.apps.flux2.enabled }}
{{- fail "fluxGitops.enabled requires apps.flux2.enabled" }}
{{- end }}
{{- end }}
{{- if .Values.exampleIngress.enabled }}
{{- $ch := dig "hosts" "cilikube" "" .Values }}
{{- $gh := dig "hosts" "grafana" "" .Values }}
{{- if and (eq $ch "") (eq $gh "") }}
{{- fail "exampleIngress.enabled requires hosts.cilikube or hosts.grafana in values/private.yaml" }}
{{- end }}
{{- end }}
{{/*
The example Ingresses and the ACME http01 solver both need a class that some
controller actually serves. Envoy Gateway implements Gateway API only and
ignores Ingress objects, so picking it as the entry means setting ingressClass.
*/}}
{{- $ingressClass := dig "ingressClass" "apisix" .Values }}
{{/*
Which issuer the Ingresses ask for. ACME when it can actually validate, the
cluster's own root when the hosts only resolve on the LAN, otherwise the
per-certificate selfSigned issuer that is always there.
*/}}
{{/*
Alertmanager only gets a route to Lark when the adapter is actually rendered;
otherwise its alerts would go to a receiver that nothing is listening on.
*/}}
{{- $larkAlerts := and (dig "alerting" "lark" "enabled" false .Values) (ne (dig "alerting" "lark" "webhookUrl" "" .Values) "") }}
{{- $clusterIssuer := "selfsigned" }}
{{- if .Values.letsencrypt.enabled | default false }}
{{- $clusterIssuer = "letsencrypt-prod" }}
{{- else if dig "localCa" "enabled" false .Values }}
{{- $clusterIssuer = "local-ca" }}
{{- end }}
{{- if and (or .Values.exampleIngress.enabled (.Values.letsencrypt.enabled | default false)) (eq $ingressClass "apisix") (not .Values.apps.apisix.enabled) }}
{{- fail "ingressClass is apisix but apps.apisix is disabled; enable APISIX or set ingressClass in values/private.yaml to a class a running controller serves" }}
{{- end }}
{{/*
platform-config writes Ingresses into other releases' namespaces, so it has to
run after the releases that create them.
*/}}
{{- $pcNeeds := list }}
{{- if .Values.apps.metallb.enabled }}
{{- $pcNeeds = append $pcNeeds (printf "%s/metallb" .Values.apps.metallb.namespace) }}
{{- end }}
{{- if .Values.apps.certManager.enabled }}
{{- $pcNeeds = append $pcNeeds (printf "%s/cert-manager" .Values.apps.certManager.namespace) }}
{{- end }}
{{- if and .Values.exampleIngress.enabled .Values.apps.cilikube.enabled (dig "hosts" "cilikube" "" .Values) }}
{{- $pcNeeds = append $pcNeeds (printf "%s/cilikube" .Values.apps.cilikube.namespace) }}
{{- end }}

repositories:
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: open-telemetry
    url: https://open-telemetry.github.io/opentelemetry-helm-charts
  - name: grafana
    url: https://grafana.github.io/helm-charts
  - name: headlamp
    url: https://kubernetes-sigs.github.io/headlamp/
  - name: argo
    url: https://argoproj.github.io/argo-helm
  - name: fluxcd-community
    url: https://fluxcd-community.github.io/helm-charts
  - name: gitlab
    url: https://charts.gitlab.io/
  - name: jenkins
    url: https://charts.jenkins.io
  - name: apisix
    url: https://charts.apiseven.com
  - name: ciliverse
    url: https://charts.cillian.website
  - name: containeroo
    url: https://charts.containeroo.ch
  - name: metallb
    url: https://metallb.github.io/metallb
  - name: jetstack
    url: https://charts.jetstack.io
  - name: rustfs
    url: https://charts.rustfs.com
  - name: minio
    url: https://charts.min.io/
  - name: juicefs
    url: https://juicedata.github.io/charts/
  - name: nats
    url: https://nats-io.github.io/k8s/helm/charts/
  - name: harbor
    url: https://helm.goharbor.io
  - name: vm
    url: https://victoriametrics.github.io/helm-charts/
  - name: istio
    url: https://istio-release.storage.googleapis.com/charts
  - name: metrics-server
    url: https://kubernetes-sigs.github.io/metrics-server/
  - name: external-dns
    url: https://kubernetes-sigs.github.io/external-dns/

releases:
  - name: kube-prometheus-stack
    namespace: {{ .Values.apps.kubePrometheusStack.namespace }}
    chart: prometheus-community/kube-prometheus-stack
    version: {{ .Values.apps.kubePrometheusStack.version | quote }}
    installed: {{ .Values.apps.kubePrometheusStack.enabled }}
    createNamespace: true
    values:
      - values/apps/kube-prometheus-stack.yaml
      {{- with dig "secrets" "grafanaAdminPassword" "" .Values }}
      # The chart generates a fresh random password on every render, so leaving
      # this empty rotates the admin login on each upgrade.
      - grafana:
          adminPassword: {{ . | quote }}
      {{- end }}
      {{- with dig "hosts" "grafana" "" .Values }}
      - grafana:
          ingress:
            enabled: true
            ingressClassName: {{ $ingressClass | quote }}
            hosts: [{{ . | quote }}]
            annotations:
              cert-manager.io/cluster-issuer: {{ $clusterIssuer | quote }}
            tls:
              - secretName: grafana-tls
                hosts: [{{ . | quote }}]
          grafana.ini:
            server:
              # Grafana builds redirects and share links from this. The gateway
              # terminates TLS, so it cannot infer the scheme on its own.
              domain: {{ . | quote }}
              root_url: {{ printf "https://%s" . | quote }}
      {{- end }}
      {{- with dig "hosts" "prometheus" "" .Values }}
      # No authentication in front of this UI: anyone who reaches the host can
      # read every metric the cluster collects.
      - prometheus:
          prometheusSpec:
            # The chart derives this from the ingress host as plain http; the
            # gateway serves https, and these links get handed to users.
            externalUrl: {{ printf "https://%s" . | quote }}
          ingress:
            enabled: true
            ingressClassName: {{ $ingressClass | quote }}
            hosts: [{{ . | quote }}]
            paths: ["/"]
            pathType: Prefix
            annotations:
              cert-manager.io/cluster-issuer: {{ $clusterIssuer | quote }}
            tls:
              - secretName: prometheus-tls
                hosts: [{{ . | quote }}]
      {{- end }}
      {{- with dig "hosts" "alertmanager" "" .Values }}
      # Same caveat as Prometheus, and worse: this UI can silence alerts.
      - alertmanager:
          alertmanagerSpec:
            externalUrl: {{ printf "https://%s" . | quote }}
          ingress:
            enabled: true
            ingressClassName: {{ $ingressClass | quote }}
            hosts: [{{ . | quote }}]
            paths: ["/"]
            pathType: Prefix
            annotations:
              cert-manager.io/cluster-issuer: {{ $clusterIssuer | quote }}
            tls:
              - secretName: alertmanager-tls
                hosts: [{{ . | quote }}]
      {{- end }}
      {{- if $larkAlerts }}
      # The chart default routes everything to a receiver named 'null', so
      # alerts fire into nothing until a real one is named here.
      - alertmanager:
          config:
            route:
              group_by: ["alertname", "namespace"]
              group_wait: 30s
              group_interval: 5m
              repeat_interval: 4h
              receiver: lark
              routes:
                # Watchdog fires forever by design; it proves the pipeline
                # works and is not something to notify on.
                - receiver: "null"
                  matchers:
                    - alertname = "Watchdog"
            receivers:
              - name: "null"
              - name: lark
                webhook_configs:
                  - url: http://alert-lark.{{ .Values.apps.kubePrometheusStack.namespace }}.svc:8080/
                    send_resolved: true
      {{- end }}
      {{- if eq .Environment.Name "kind" }}
      - values/kind/kube-prometheus-stack.yaml
      {{- if .Values.kindMirror }}
      - values/kind/kube-prometheus-stack-mirror.yaml
      {{- end }}
      {{- end }}

  - name: opentelemetry-collector
    namespace: {{ .Values.apps.opentelemetryCollector.namespace }}
    chart: open-telemetry/opentelemetry-collector
    version: {{ .Values.apps.opentelemetryCollector.version | quote }}
    installed: {{ .Values.apps.opentelemetryCollector.enabled }}
    createNamespace: true
    values:
      - values/apps/opentelemetry-collector.yaml

  - name: tempo
    namespace: {{ .Values.apps.tempo.namespace }}
    chart: grafana/tempo
    version: {{ .Values.apps.tempo.version | quote }}
    installed: {{ .Values.apps.tempo.enabled }}
    createNamespace: true
    values:
      - values/apps/tempo.yaml

  - name: victoria-logs-single
    namespace: {{ .Values.apps.victoriaLogs.namespace }}
    chart: vm/victoria-logs-single
    version: {{ .Values.apps.victoriaLogs.version | quote }}
    installed: {{ .Values.apps.victoriaLogs.enabled }}
    createNamespace: true
    values:
      - values/apps/victoria-logs-single.yaml

  - name: victoria-logs-collector
    namespace: {{ .Values.apps.victoriaLogsCollector.namespace }}
    chart: vm/victoria-logs-collector
    version: {{ .Values.apps.victoriaLogsCollector.version | quote }}
    installed: {{ .Values.apps.victoriaLogsCollector.enabled }}
    createNamespace: true
    {{- if .Values.apps.victoriaLogsCollector.enabled }}
    needs:
      - {{ .Values.apps.victoriaLogs.namespace }}/victoria-logs-single
    {{- end }}
    values:
      - values/apps/victoria-logs-collector.yaml
      - remoteWrite:
          - url: http://victoria-logs-single-server.{{ .Values.apps.victoriaLogs.namespace }}.svc:9428

  - name: victoria-metrics-single
    namespace: {{ .Values.apps.victoriaMetrics.namespace }}
    chart: vm/victoria-metrics-single
    version: {{ .Values.apps.victoriaMetrics.version | quote }}
    installed: {{ .Values.apps.victoriaMetrics.enabled }}
    createNamespace: true
    values:
      - values/apps/victoria-metrics-single.yaml

  - name: loki
    namespace: {{ .Values.apps.loki.namespace }}
    chart: grafana/loki
    version: {{ .Values.apps.loki.version | quote }}
    installed: {{ .Values.apps.loki.enabled }}
    createNamespace: true
    values:
      - values/apps/loki.yaml

  - name: promtail
    namespace: {{ .Values.apps.loki.namespace }}
    chart: grafana/promtail
    version: {{ .Values.apps.promtail.version | quote }}
    installed: {{ .Values.apps.loki.enabled }}
    createNamespace: true
    {{- if .Values.apps.loki.enabled }}
    needs:
      - {{ .Values.apps.loki.namespace }}/loki
    {{- end }}
    values:
      - values/apps/promtail.yaml
      - config:
          clients:
            - url: http://loki.{{ .Values.apps.loki.namespace }}.svc:3100/loki/api/v1/push

  - name: pyroscope
    namespace: {{ .Values.apps.pyroscope.namespace }}
    chart: grafana/pyroscope
    version: {{ .Values.apps.pyroscope.version | quote }}
    installed: {{ .Values.apps.pyroscope.enabled }}
    createNamespace: true
    values:
      - values/apps/pyroscope.yaml

  - name: beyla
    namespace: {{ .Values.apps.beyla.namespace }}
    chart: grafana/beyla
    version: {{ .Values.apps.beyla.version | quote }}
    installed: {{ .Values.apps.beyla.enabled }}
    createNamespace: true
    values:
      - values/apps/beyla.yaml

  - name: istio-base
    namespace: {{ .Values.apps.istio.namespace }}
    chart: istio/base
    version: {{ .Values.apps.istio.version | quote }}
    installed: {{ .Values.apps.istio.enabled }}
    createNamespace: true
    values:
      - values/apps/istio-base.yaml

  - name: istiod
    namespace: {{ .Values.apps.istio.namespace }}
    chart: istio/istiod
    version: {{ .Values.apps.istio.version | quote }}
    installed: {{ .Values.apps.istio.enabled }}
    createNamespace: true
    wait: true
    timeout: 600
    {{- if .Values.apps.istio.enabled }}
    needs:
      - {{ .Values.apps.istio.namespace }}/istio-base
    {{- end }}
    values:
      - values/apps/istiod.yaml

  - name: headlamp
    namespace: {{ .Values.apps.headlamp.namespace }}
    chart: headlamp/headlamp
    version: {{ .Values.apps.headlamp.version | quote }}
    installed: {{ .Values.apps.headlamp.enabled }}
    createNamespace: true

  # Chart index on charts.cillian.website is still 1.0.0; image tags in values/apps/cilikube.yaml track app v1.5.0.
  - name: cilikube
    namespace: {{ .Values.apps.cilikube.namespace }}
    chart: ciliverse/cilikube
    version: {{ .Values.apps.cilikube.version | quote }}
    installed: {{ .Values.apps.cilikube.enabled }}
    createNamespace: true
    values:
      - values/apps/cilikube.yaml
      # A map under a release's `values:` is inline values, not a file
      # reference, so `- path: values/private.yaml` would hand the chart two
      # junk keys and no secrets. Pass the two keys the chart needs.
      - secrets:
          jwtSecret: {{ dig "secrets" "jwtSecret" "" .Values | quote }}
          encryptionKey: {{ dig "secrets" "encryptionKey" "" .Values | quote }}

  - name: local-path-provisioner
    namespace: {{ .Values.apps.localPathProvisioner.namespace }}
    chart: containeroo/local-path-provisioner
    version: {{ .Values.apps.localPathProvisioner.version | quote }}
    installed: {{ .Values.apps.localPathProvisioner.enabled }}
    createNamespace: true
    values:
      - values/apps/local-path-provisioner.yaml

  - name: metallb
    namespace: {{ .Values.apps.metallb.namespace }}
    chart: metallb/metallb
    version: {{ .Values.apps.metallb.version | quote }}
    installed: {{ .Values.apps.metallb.enabled }}
    createNamespace: true
    wait: true
    timeout: 600
    values:
      - values/apps/metallb.yaml

  - name: metrics-server
    namespace: {{ .Values.apps.metricsServer.namespace }}
    chart: metrics-server/metrics-server
    version: {{ .Values.apps.metricsServer.version | quote }}
    installed: {{ .Values.apps.metricsServer.enabled }}
    createNamespace: true
    values:
      - values/apps/metrics-server.yaml

  - name: cert-manager
    namespace: {{ .Values.apps.certManager.namespace }}
    chart: jetstack/cert-manager
    version: {{ .Values.apps.certManager.version | quote }}
    installed: {{ .Values.apps.certManager.enabled }}
    createNamespace: true
    wait: true
    timeout: 600
    values:
      - values/apps/cert-manager.yaml

  - name: platform-config
    namespace: platform-config
    chart: ./charts/platform-config
    installed: {{ or .Values.apps.metallb.enabled .Values.apps.certManager.enabled }}
    createNamespace: true
    {{- with $pcNeeds }}
    needs:
      {{- range . }}
      - {{ . }}
      {{- end }}
    {{- end }}
    values:
      - values/apps/platform-config.yaml
      - metallb:
          enabled: {{ .Values.apps.metallb.enabled }}
          addresses: {{ dig "metallb" "addresses" "" .Values | quote }}
          # The pool only counts when it sits in MetalLB's own namespace.
          namespace: {{ .Values.apps.metallb.namespace }}
        certManager:
          enabled: {{ .Values.apps.certManager.enabled }}
        letsencrypt:
          enabled: {{ .Values.letsencrypt.enabled | default false }}
          email: {{ dig "letsencrypt" "email" "" .Values | quote }}
          ingressClass: {{ $ingressClass | quote }}
        localCa:
          enabled: {{ dig "localCa" "enabled" false .Values }}
        alerting:
          lark:
            enabled: {{ $larkAlerts }}
            namespace: {{ .Values.apps.kubePrometheusStack.namespace }}
            webhookUrl: {{ dig "alerting" "lark" "webhookUrl" "" .Values | quote }}
            signSecret: {{ dig "alerting" "lark" "signSecret" "" .Values | quote }}
        exampleIngress:
          enabled: {{ .Values.exampleIngress.enabled | default false }}
          clusterIssuer: {{ $clusterIssuer | quote }}
          ingressClass: {{ $ingressClass | quote }}
          cilikube:
            namespace: {{ .Values.apps.cilikube.namespace }}
            host: {{ dig "hosts" "cilikube" "" .Values | quote }}
          grafana:
            namespace: {{ .Values.apps.kubePrometheusStack.namespace }}
            host: {{ dig "hosts" "grafana" "" .Values | quote }}

  - name: apisix
    namespace: {{ .Values.apps.apisix.namespace }}
    chart: apisix/apisix
    version: {{ .Values.apps.apisix.version | quote }}
    installed: {{ .Values.apps.apisix.enabled }}
    createNamespace: true
    {{- if .Values.apps.metallb.enabled }}
    needs:
      - {{ .Values.apps.metallb.namespace }}/metallb
    {{- end }}
    values:
      - values/apps/apisix.yaml
      {{- if eq .Environment.Name "kind" }}
      - values/kind/apisix.yaml
      {{- end }}

  - name: gateway-api
    namespace: {{ .Values.apps.gatewayApi.namespace }}
    chart: oci://docker.io/envoyproxy/gateway-crds-helm
    version: {{ .Values.apps.gatewayApi.version | quote }}
    installed: {{ or .Values.apps.gatewayApi.enabled .Values.apps.envoyGateway.enabled }}
    createNamespace: true
    values:
      - values/apps/gateway-api.yaml
      - crds:
          envoyGateway:
            enabled: {{ .Values.apps.envoyGateway.enabled }}

  - name: envoy-gateway
    namespace: {{ .Values.apps.envoyGateway.namespace }}
    chart: oci://docker.io/envoyproxy/gateway-helm
    version: {{ .Values.apps.envoyGateway.version | quote }}
    installed: {{ .Values.apps.envoyGateway.enabled }}
    createNamespace: true
    wait: true
    timeout: 600
    {{- if .Values.apps.envoyGateway.enabled }}
    needs:
      - {{ .Values.apps.gatewayApi.namespace }}/gateway-api
    {{- end }}
    values:
      - values/apps/envoy-gateway.yaml

  - name: external-dns
    namespace: {{ .Values.apps.externalDns.namespace }}
    chart: external-dns/external-dns
    version: {{ .Values.apps.externalDns.version | quote }}
    installed: {{ .Values.apps.externalDns.enabled }}
    createNamespace: true
    values:
      - values/apps/external-dns.yaml
      - provider:
          name: {{ dig "externalDns" "provider" "" .Values | quote }}
        txtOwnerId: {{ dig "externalDns" "txtOwnerId" "helm-charts" .Values | quote }}
        domainFilters: {{ dig "externalDns" "domainFilters" list .Values | toJson }}
        {{- if or .Values.apps.gatewayApi.enabled .Values.apps.envoyGateway.enabled }}
        sources:
          - service
          - ingress
          - gateway-httproute
        {{- else }}
        sources:
          - service
          - ingress
        {{- end }}
        {{- if eq (dig "externalDns" "provider" "" .Values) "cloudflare" }}
        env:
          - name: CF_API_TOKEN
            value: {{ dig "externalDns" "cloudflareApiToken" "" .Values | quote }}
        {{- end }}

  # Release name is `argocd`, not the chart name: it matches the namespace and
  # the argocd CLI, and renaming an installed release means uninstalling it —
  # which takes the CRDs and every Application object with it.
  - name: argocd
    namespace: {{ .Values.apps.argoCd.namespace }}
    chart: argo/argo-cd
    version: {{ .Values.apps.argoCd.version | quote }}
    installed: {{ .Values.apps.argoCd.enabled }}
    createNamespace: true
    values:
      - values/apps/argo-cd.yaml
      {{- with dig "hosts" "argocd" "" .Values }}
      - global:
          domain: {{ . | quote }}
        server:
          ingress:
            enabled: true
            ingressClassName: {{ $ingressClass | quote }}
            hostname: {{ . | quote }}
            annotations:
              cert-manager.io/cluster-issuer: {{ $clusterIssuer | quote }}
            # Chart wires this to the argocd-server-tls secret.
            tls: true
      {{- end }}

  - name: flux2
    namespace: {{ .Values.apps.flux2.namespace }}
    chart: fluxcd-community/flux2
    version: {{ .Values.apps.flux2.version | quote }}
    installed: {{ .Values.apps.flux2.enabled }}
    createNamespace: true
    values:
      - values/apps/flux2.yaml

{{- if and .Values.apps.flux2.enabled (dig "apps" "fluxOperator" "enabled" false .Values) }}
{{- fail "apps.flux2 and apps.fluxOperator both install the Flux controllers; enable one" }}
{{- end }}

  - name: flux-operator
    namespace: {{ dig "apps" "fluxOperator" "namespace" "flux-system" .Values }}
    chart: oci://ghcr.io/controlplaneio-fluxcd/charts/flux-operator
    version: {{ dig "apps" "fluxOperator" "version" "" .Values | quote }}
    installed: {{ dig "apps" "fluxOperator" "enabled" false .Values }}
    createNamespace: true
    values:
      - values/apps/flux-operator.yaml

  - name: flux-gitops
    namespace: {{ .Values.apps.flux2.namespace }}
    chart: ./charts/flux-gitops
    installed: {{ .Values.fluxGitops.enabled | default false }}
    createNamespace: true
    needs:
      - {{ .Values.apps.flux2.namespace }}/flux2
    values:
      - source:
          name: {{ dig "fluxGitops" "sourceName" "gitops" .Values | quote }}
          url: {{ dig "fluxGitops" "gitUrl" "" .Values | quote }}
          branch: {{ dig "fluxGitops" "branch" "main" .Values | quote }}
          password: {{ dig "fluxGitops" "deployToken" "" .Values | quote }}
        kustomizations:
{{ dig "fluxGitops" "kustomizations" (list) .Values | toYaml | indent 10 }}

  - name: gitlab
    namespace: {{ .Values.apps.gitlab.namespace }}
    chart: gitlab/gitlab
    version: {{ .Values.apps.gitlab.version | quote }}
    installed: {{ .Values.apps.gitlab.enabled }}
    createNamespace: true
    values:
      - values/apps/gitlab.yaml
      - registry:
          enabled: {{ not .Values.apps.harbor.enabled }}
          storage:
            secret: {{ dig "gitlab" "registryStorageSecret" "gitlab-registry-storage" .Values | quote }}
            key: config
        global:
          hosts:
            domain: {{ dig "gitlab" "domain" "" .Values | quote }}
          psql:
            host: {{ $glPsql }}
            port: 5432
            username: {{ dig "gitlab" "psqlUsername" "gitlab" .Values | quote }}
            database: {{ dig "gitlab" "psqlDatabase" "gitlabhq_production" .Values | quote }}
            password:
              secret: {{ dig "gitlab" "psqlPasswordSecret" "gitlab-psql" .Values | quote }}
              key: password
          redis:
            host: {{ $glRedis }}
            port: 6379
            auth:
              enabled: true
              secret: {{ dig "gitlab" "redisPasswordSecret" "gitlab-redis" .Values | quote }}
              key: redis-password
          registry:
            bucket: {{ dig "gitlab" "registryBucket" "gitlab-registry" .Values | quote }}
          appConfig:
            object_store:
              enabled: true
              connection:
                secret: {{ dig "gitlab" "objectStorageSecret" "gitlab-object-storage" .Values | quote }}
                key: connection
            backups:
              bucket: {{ dig "gitlab" "backupBucket" "gitlab-backups" .Values | quote }}
              tmpBucket: {{ dig "gitlab" "backupTmpBucket" "gitlab-backups-tmp" .Values | quote }}
        gitlab:
          toolbox:
            backups:
              objectStorage:
                config:
                  secret: {{ dig "gitlab" "backupConfigSecret" "gitlab-s3cmd" .Values | quote }}
                  key: config

  - name: gitlab-runner
    namespace: {{ .Values.apps.gitlabRunner.namespace }}
    chart: gitlab/gitlab-runner
    version: {{ .Values.apps.gitlabRunner.version | quote }}
    installed: {{ .Values.apps.gitlabRunner.enabled }}
    createNamespace: true
    values:
      - values/apps/gitlab-runner.yaml
      - gitlabUrl: {{ dig "gitlabRunner" "gitlabUrl" "" .Values | quote }}
        runnerToken: {{ dig "gitlabRunner" "runnerToken" "" .Values | quote }}
      {{- with dig "gitlabRunner" "hostAliases" list .Values }}
      # CoreDNS does not read node /etc/hosts. The top-level list reaches the
      # runner pod; job pods are separate and need the same entries repeated
      # inside runners.config, or DinD cannot resolve the registry.
      - hostAliases:
          {{- range . }}
          - ip: {{ .ip | quote }}
            hostnames:
              {{- range .hostnames }}
              - {{ . | quote }}
              {{- end }}
          {{- end }}
        runners:
          config: |
            [[runners]]
              [runners.kubernetes]
                namespace = "{{ `{{ default .Release.Namespace .Values.runners.jobNamespace }}` }}"
                image = "alpine"
                privileged = true
                {{- range . }}
                [[runners.kubernetes.host_aliases]]
                  ip = {{ .ip | quote }}
                  hostnames = [{{ range $i, $h := .hostnames }}{{ if $i }}, {{ end }}{{ $h | quote }}{{ end }}]
                {{- end }}
      {{- end }}

  - name: jenkins
    namespace: {{ .Values.apps.jenkins.namespace }}
    chart: jenkins/jenkins
    version: {{ .Values.apps.jenkins.version | quote }}
    installed: {{ .Values.apps.jenkins.enabled }}
    createNamespace: true
    values:
      - values/apps/jenkins.yaml
      {{- with dig "hosts" "jenkins" "" .Values }}
      - controller:
          # Jenkins builds absolute URLs from this; leaving it unset makes
          # links point at the in-cluster Service name.
          jenkinsUrl: {{ printf "https://%s" . | quote }}
          ingress:
            enabled: true
            # Chart still defaults to extensions/v1beta1.
            apiVersion: networking.k8s.io/v1
            ingressClassName: {{ $ingressClass | quote }}
            hostName: {{ . | quote }}
            # The chart leaves both empty, which renders a rule with no path at
            # all; not every controller treats that as "everything".
            path: /
            pathType: Prefix
            annotations:
              cert-manager.io/cluster-issuer: {{ $clusterIssuer | quote }}
            tls:
              - secretName: jenkins-tls
                hosts:
                  - {{ . | quote }}
      {{- end }}

  - name: harbor
    namespace: {{ .Values.apps.harbor.namespace }}
    chart: harbor/harbor
    version: {{ .Values.apps.harbor.version | quote }}
    installed: {{ .Values.apps.harbor.enabled }}
    createNamespace: true
    values:
      - values/apps/harbor.yaml
      - harborAdminPassword: {{ dig "harbor" "adminPassword" "" .Values | quote }}

  - name: postgresql
    namespace: {{ .Values.apps.postgresql.namespace }}
    chart: oci://registry-1.docker.io/bitnamicharts/postgresql
    version: {{ .Values.apps.postgresql.version | quote }}
    installed: {{ .Values.apps.postgresql.enabled }}
    createNamespace: true
    values:
      - values/apps/postgresql.yaml

  - name: redis
    namespace: {{ .Values.apps.redis.namespace }}
    chart: oci://registry-1.docker.io/bitnamicharts/redis
    version: {{ .Values.apps.redis.version | quote }}
    installed: {{ .Values.apps.redis.enabled }}
    createNamespace: true
    values:
      - values/apps/redis.yaml
      - auth:
          password: {{ dig "redis" "password" "" .Values | quote }}

  - name: rustfs
    namespace: {{ .Values.apps.rustfs.namespace }}
    chart: rustfs/rustfs
    version: {{ .Values.apps.rustfs.version | quote }}
    installed: {{ .Values.apps.rustfs.enabled }}
    createNamespace: true
    values:
      - values/apps/rustfs.yaml
      - secret:
          rustfs:
            access_key: {{ dig "rustfs" "accessKey" "" .Values | quote }}
            secret_key: {{ dig "rustfs" "secretKey" "" .Values | quote }}

  - name: minio
    namespace: {{ .Values.apps.minio.namespace }}
    chart: minio/minio
    version: {{ .Values.apps.minio.version | quote }}
    installed: {{ .Values.apps.minio.enabled }}
    createNamespace: true
    values:
      - values/apps/minio.yaml
      - rootUser: {{ dig "minio" "rootUser" "" .Values | quote }}
        rootPassword: {{ dig "minio" "rootPassword" "" .Values | quote }}

  - name: juicefs-csi-driver
    namespace: {{ .Values.apps.juicefsCsi.namespace }}
    chart: juicefs/juicefs-csi-driver
    version: {{ .Values.apps.juicefsCsi.version | quote }}
    installed: {{ .Values.apps.juicefsCsi.enabled }}
    createNamespace: true
    {{- if .Values.apps.juicefsCsi.enabled }}
    needs:
      - {{ .Values.apps.redis.namespace }}/redis
      {{- if .Values.apps.rustfs.enabled }}
      - {{ .Values.apps.rustfs.namespace }}/rustfs
      {{- else if .Values.apps.minio.enabled }}
      - {{ .Values.apps.minio.namespace }}/minio
      {{- end }}
    {{- end }}
    values:
      - values/apps/juicefs-csi-driver.yaml
      {{- if .Values.apps.juicefsCsi.enabled }}
      - storageClasses:
          - name: juicefs
            enabled: true
            reclaimPolicy: Delete
            backend:
              name: {{ dig "juicefs" "name" "jfs" .Values | quote }}
              metaurl: {{ printf "redis://:%s@redis-master.%s.svc:6379/1" (dig "redis" "password" "" .Values) .Values.apps.redis.namespace | quote }}
              storage: minio
              {{- if .Values.apps.rustfs.enabled }}
              bucket: {{ printf "http://rustfs-svc.%s.svc:9000/%s" .Values.apps.rustfs.namespace (dig "juicefs" "name" "jfs" .Values) | quote }}
              accessKey: {{ dig "rustfs" "accessKey" "" .Values | quote }}
              secretKey: {{ dig "rustfs" "secretKey" "" .Values | quote }}
              {{- else }}
              bucket: {{ printf "http://minio.%s.svc:9000/%s" .Values.apps.minio.namespace (dig "juicefs" "name" "jfs" .Values) | quote }}
              accessKey: {{ dig "minio" "rootUser" "" .Values | quote }}
              secretKey: {{ dig "minio" "rootPassword" "" .Values | quote }}
              {{- end }}
      {{- end }}

  - name: nats
    namespace: {{ .Values.apps.nats.namespace }}
    chart: nats/nats
    version: {{ .Values.apps.nats.version | quote }}
    installed: {{ .Values.apps.nats.enabled }}
    createNamespace: true
    values:
      - values/apps/nats.yaml
